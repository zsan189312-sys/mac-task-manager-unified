[Unit]
Description=TMU Mobile read-only monitoring gateway
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=xx
WorkingDirectory=/home/xx/services/tmu-mobile
ExecStart=/usr/bin/node /home/xx/services/tmu-mobile/server/gateway.cjs /home/xx/.config/tmu-mobile/gateway.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M
CPUQuota=15%

[Install]
WantedBy=multi-user.target
